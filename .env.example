# Optional. Leave unset for the fully functional deterministic guide.
# Server-only; never prefix keys with NEXT_PUBLIC_. Never commit .env.local.
MSDS_AI_API_KEY=
MSDS_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
MSDS_AI_MODEL=gpt-4.1-mini
# Optional separately hosted guide service. Public URL only; never a key.
NEXT_PUBLIC_MSDS_GUIDE_ENDPOINT=
MSDS_ALLOWED_ORIGINS=http://localhost:3000,https://ohyoo.github.io
# GitHub project Pages build uses /MSDS; leave blank for local development.
NEXT_PUBLIC_BASE_PATH=
